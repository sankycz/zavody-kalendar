{
  "name": "zavody-kalendar",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "deploy": "vite build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply zavody-kalendar --remote",
    "fixtures:fetch": "node --experimental-strip-types scripts/fetch-fixtures.ts",
    "fixtures:extract": "node --experimental-strip-types scripts/extract-fixtures.ts",
    "typecheck": "tsc -p . && tsc -p web && tsc -p web/sw",
    "test": "vitest run",
    "dev:api": "wrangler dev --local",
    "build": "vite build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.144.0"
  }
}
