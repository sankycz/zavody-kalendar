{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zavody-kalendar",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Web app (Vite build) served as static assets; /api and /admin go to the Worker.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  // Weekly ingest Monday 05:00 Prague time: both UTC slots fire, the Worker runs only
  // in the one that is 05:00 in Prague (03:00 UTC in summer, 04:00 UTC in winter).
  // Unchanged sources are skipped by content hash.
  "triggers": { "crons": ["0 3 * * 1", "0 4 * * 1"] },
  "vars": {
    // Extraction model: "workers-ai" (free 10k neurons/day) or "claude" (Claude API, needs ANTHROPIC_API_KEY).
    "EXTRACTOR": "workers-ai",
    "WORKERS_AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "CLAUDE_MODEL": "claude-opus-5-5",
    "CONTACT_EMAIL": "j.sankot@gmail.com"
  },
  // Secrets (wrangler secret put): ADMIN_TOKEN, ANTHROPIC_API_KEY when EXTRACTOR = "claude",
  // APIFY_TOKEN for Facebook sources (kind 'facebook' in the sources table).
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zavody-kalendar",
      "database_id": "f7218d02-7f49-4b08-877f-49fecea6124f",
      "migrations_dir": "migrations"
    }
  ]
}
