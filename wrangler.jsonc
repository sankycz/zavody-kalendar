{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zavody-kalendar",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Web app (Vite build) served as static assets; /api and /admin go to the Worker.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  // Weekly ingest: Monday 03:17 UTC.
  "triggers": { "crons": ["17 3 * * 1"] },
  "vars": {
    "CLAUDE_MODEL": "claude-opus-5-5",
    "CONTACT_EMAIL": "j.sankot@gmail.com"
  },
  // Secrets (wrangler secret put): ANTHROPIC_API_KEY, ADMIN_TOKEN
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zavody-kalendar",
      "database_id": "f7218d02-7f49-4b08-877f-49fecea6124f",
      "migrations_dir": "migrations"
    }
  ]
}
