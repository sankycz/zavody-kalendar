{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zavody-kalendar",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Web app (Vite build) served as static assets; /api and /admin go to the Worker.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  // Daily ingest 03:17 UTC; unchanged sources are skipped by content hash.
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    // Extraction model: "workers-ai" (free 10k neurons/day) or "claude" (Claude API, needs ANTHROPIC_API_KEY).
    "EXTRACTOR": "workers-ai",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "CLAUDE_MODEL": "claude-opus-5-5",
    "CONTACT_EMAIL": "j.sankot@gmail.com"
  },
  // Secrets (wrangler secret put): ADMIN_TOKEN, and ANTHROPIC_API_KEY when EXTRACTOR = "claude"
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zavody-kalendar",
      "database_id": "f7218d02-7f49-4b08-877f-49fecea6124f",
      "migrations_dir": "migrations"
    }
  ]
}
